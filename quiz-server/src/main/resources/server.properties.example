# ====================================================================
# Online Quiz Server Configuration (Template)
# ====================================================================

# Network & Thread Pool
server.port=5555
server.max.connections=100
server.worker.pool.size=8
server.worker.queue.capacity=200
server.request.grace.seconds=3
server.handshake.timeout.ms=5000
server.read.timeout.ms=300000
server.shutdown.timeout.ms=10000

# Database Connection (HikariCP)
db.url=jdbc:postgresql://localhost:5432/quizdb
db.user=postgres
db.password=your_db_password_here
db.pool.max.size=10
db.pool.min.idle=2
db.pool.idle.timeout.ms=300000
db.pool.connection.timeout.ms=20000
quiz.allow_demo_seed=on

