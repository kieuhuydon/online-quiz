<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns:fx="http://javafx.com/fxml/1" fx:controller="quiz.client.ui.student.StudentController" spacing="14">
    <!-- Top Action Toolbar (No redundant page header) -->
    <HBox alignment="CENTER_LEFT" spacing="12" style="-fx-padding: 0 0 4 0;">
        <Label fx:id="studentWelcome" visible="false" managed="false"/>
        <Label fx:id="studentClassLabel" text="Lớp: đang tải…" styleClass="badge" style="-fx-font-size: 13px; -fx-padding: 6 12;"/>
        <Region HBox.hgrow="ALWAYS"/>
        <ProgressIndicator fx:id="studentProgress" visible="false" prefWidth="22" prefHeight="22"/>
        <Button fx:id="btnRefresh" text="🔄 Tải lại danh sách" onAction="#loadAssignedQuizzes" styleClass="primary-button"/>
    </HBox>

    <!-- KPI Summary Cards -->
    <HBox spacing="14">
        <VBox styleClass="stat-card" HBox.hgrow="ALWAYS" spacing="4">
            <Label text="TỔNG BÀI ĐƯỢC GIAO" styleClass="stat-label"/>
            <Label fx:id="lblTotalAssigned" text="0" styleClass="stat-value"/>
        </VBox>
        <VBox styleClass="stat-card" HBox.hgrow="ALWAYS" spacing="4">
            <Label text="SẴN SÀNG VÀO THI" styleClass="stat-label"/>
            <Label fx:id="lblReadyExams" text="0" styleClass="stat-value" style="-fx-text-fill: #059669;"/>
        </VBox>
        <VBox styleClass="stat-card" HBox.hgrow="ALWAYS" spacing="4">
            <Label text="ĐÃ HOÀN THÀNH" styleClass="stat-label"/>
            <Label fx:id="lblCompletedExams" text="0" styleClass="stat-value" style="-fx-text-fill: #4f46e5;"/>
        </VBox>
    </HBox>

    <Label fx:id="studentNotice" visible="false" managed="false" styleClass="notice" wrapText="true" maxWidth="Infinity"/>

    <!-- Action Toolbar / Hint -->
    <HBox fx:id="actionToolbar" spacing="10" alignment="CENTER_LEFT" styleClass="toolbar-card">
        <Label text="💡 Chọn một bài kiểm tra trong bảng bên dưới để xem thông tin chi tiết và bắt đầu làm bài." styleClass="muted"/>
        <Region HBox.hgrow="ALWAYS"/>
    </HBox>

    <!-- Master-Detail Split View: Left Table + Right Inspector Card -->
    <HBox spacing="16" VBox.vgrow="ALWAYS" alignment="TOP_LEFT">
        <!-- Table of assigned quizzes (FR-S02) -->
        <TableView fx:id="assignedQuizTable" prefHeight="400" minHeight="300" HBox.hgrow="ALWAYS" styleClass="account-card"/>

        <!-- Quiz Information Inspector Card (FR-S04) -->
        <VBox fx:id="quizInfoPanel" visible="false" managed="false" prefWidth="360" minWidth="320" maxWidth="380" styleClass="content-card" spacing="14">
            <HBox alignment="CENTER_LEFT" spacing="8">
                <VBox spacing="2" HBox.hgrow="ALWAYS">
                    <Label text="CHI TIẾT BÀI KIỂM TRA" styleClass="eyebrow"/>
                    <Label fx:id="infoTitle" text="Tên đề thi" styleClass="card-heading" wrapText="true"/>
                </VBox>
                <Button fx:id="btnCloseInfo" text="✕" onAction="#onCloseInfoClick" styleClass="secondary-button, btn-small"/>
            </HBox>
            <Separator/>
            <GridPane hgap="12" vgap="10">
                <columnConstraints>
                    <ColumnConstraints minWidth="125" prefWidth="130"/>
                    <ColumnConstraints hgrow="ALWAYS"/>
                </columnConstraints>

                <Label text="Trạng thái:" styleClass="field-label" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                <Label fx:id="infoStatus" text="" styleClass="badge, badge-open" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                <Label text="Chủ đề:" styleClass="field-label" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                <Label fx:id="infoCategory" text="" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                <Label text="Thời lượng làm bài:" styleClass="field-label" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                <Label fx:id="infoDuration" text="" style="-fx-font-weight: bold; -fx-text-fill: #4f46e5;" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                <Label text="Số lượng câu hỏi:" styleClass="field-label" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                <Label fx:id="infoQuestionCount" text="" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

                <Label text="Điểm đạt yêu cầu:" styleClass="field-label" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
                <Label fx:id="infoPassScore" text="" style="-fx-font-weight: bold;" GridPane.rowIndex="4" GridPane.columnIndex="1"/>
            </GridPane>

            <VBox spacing="4">
                <Label fx:id="infoDescriptionLabel" text="Ghi chú / Mô tả:" styleClass="field-label"/>
                <Label fx:id="infoDescription" text="" wrapText="true" styleClass="muted"/>
            </VBox>

            <VBox spacing="4" styleClass="sub-card">
                <Label text="🛡️ Quy chế phòng thi Anti-Cheat" style="-fx-font-weight: bold; -fx-font-size: 12px; -fx-text-fill: #334155;"/>
                <Label text="• Bài thi chạy ở chế độ toàn màn hình (Full Screen).&#10;• Vui lòng đóng các ứng dụng chat, trình duyệt, điều khiển từ xa trước khi bắt đầu." wrapText="true" styleClass="muted" style="-fx-font-size: 11.5px;"/>
            </VBox>

            <Separator/>
            <HBox alignment="CENTER_RIGHT" spacing="10">
                <Button text="Đóng" onAction="#onCloseInfoClick" styleClass="secondary-button"/>
                <Button fx:id="btnStartExam" text="🚀 Bắt đầu làm bài" onAction="#onStartExamClick" styleClass="primary-button" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
            </HBox>
        </VBox>
    </HBox>
</VBox>
