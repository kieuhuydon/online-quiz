<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<VBox xmlns:fx="http://javafx.com/fxml/1" fx:controller="quiz.client.ui.student.ResultController" spacing="18" alignment="CENTER">
    <padding><Insets top="36" right="30" bottom="28" left="30"/></padding>
    <Label text="KẾT QUẢ BÀI THI" styleClass="eyebrow"/><Label fx:id="quizTitle" styleClass="page-heading" wrapText="true"/>
    <VBox alignment="CENTER" spacing="8" styleClass="content-card" maxWidth="560">
        <Label text="ĐIỂM CỦA BẠN" styleClass="eyebrow"/>
        <Label fx:id="score" style="-fx-font-size: 44px; -fx-font-weight: bold; -fx-text-fill: #172d48;"/>
    </VBox>
    <HBox spacing="12"><Button text="Xem lịch sử" onAction="#history" styleClass="secondary-button"/><Button text="Về trang chủ" onAction="#home" styleClass="primary-button"/></HBox>
</VBox>
