<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<VBox xmlns:fx="http://javafx.com/fxml/1" fx:controller="quiz.client.ui.student.HistoryController" spacing="14">
    <HBox alignment="CENTER_LEFT" spacing="12">
        <VBox spacing="2" HBox.hgrow="ALWAYS">
            <HBox alignment="CENTER_LEFT" spacing="6">
                <Hyperlink text="Bài kiểm tra được giao" onAction="#exams" styleClass="breadcrumb-link"/>
                <Label text="›" styleClass="muted"/>
                <Label text="Lịch sử làm bài" styleClass="muted"/>
            </HBox>
            <Label text="Lịch sử làm bài &amp; Kết quả" styleClass="page-heading"/>
        </VBox>
        <ProgressIndicator fx:id="progress" visible="false" prefWidth="22" prefHeight="22"/>
        <Button text="← Bài thi được giao" onAction="#exams" styleClass="secondary-button"/>
        <Button text="🔄 Tải lại" onAction="#reload" styleClass="primary-button"/>
    </HBox>
    <Label fx:id="notice" visible="false" managed="false" styleClass="notice, error-notice" wrapText="true"/>
    <TableView fx:id="table" prefHeight="460" VBox.vgrow="ALWAYS" styleClass="account-card"/>
</VBox>
