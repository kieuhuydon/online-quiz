<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<BorderPane xmlns:fx="http://javafx.com/fxml/1" fx:controller="quiz.client.ui.WorkspaceController" styleClass="workspace">
    <left>
        <VBox prefWidth="232" minWidth="212" maxWidth="232" spacing="18" styleClass="sidebar">
            <HBox alignment="CENTER_LEFT" spacing="10">
                <Label text="Q" style="-fx-background-color: #4f46e5; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 15px; -fx-padding: 5 10; -fx-background-radius: 7;"/>
                <Label text="ONLINE QUIZ" styleClass="brand"/>
            </HBox>
            <Label fx:id="roleLabel" id="roleLabel" styleClass="role-badge"/>
            <Label text="ĐIỀU HƯỚNG" styleClass="eyebrow-light"/>
            <VBox fx:id="adminNavigation" spacing="6" visible="false" managed="false">
                <Button fx:id="adminAccounts" text="Quản lí tài khoản" onAction="#accounts" styleClass="sidebar-navigation-button" maxWidth="Infinity"/>
                <Button fx:id="adminClasses" text="Quản lí lớp học" onAction="#classes" styleClass="sidebar-navigation-button" maxWidth="Infinity"/>
            </VBox>
            <VBox fx:id="teacherNavigation" spacing="6" visible="false" managed="false">
                <Button fx:id="teacherDashboard" text="Không gian giảng dạy" onAction="#teacherDashboard" styleClass="sidebar-navigation-button" maxWidth="Infinity"/>
                <Button fx:id="teacherQuestions" text="Ngân hàng câu hỏi" onAction="#teacherQuestions" styleClass="sidebar-navigation-button" maxWidth="Infinity"/>
            </VBox>
            <VBox fx:id="studentNavigation" spacing="6" visible="false" managed="false">
                <Button fx:id="studentDashboard" text="Bài kiểm tra được giao" onAction="#studentDashboard" styleClass="sidebar-navigation-button" maxWidth="Infinity"/>
                <Button fx:id="studentHistory" text="Lịch sử làm bài" onAction="#studentHistory" styleClass="sidebar-navigation-button" maxWidth="Infinity"/>
            </VBox>
            <Region VBox.vgrow="ALWAYS"/>
            <Separator style="-fx-opacity: 0.2;"/>
            <VBox spacing="4">
                <Label fx:id="fullName" id="sessionFullName" styleClass="user-name" wrapText="true"/>
                <Label fx:id="username" id="sessionUsername" styleClass="sidebar-muted" wrapText="true"/>
            </VBox>
            <Button id="logoutButton" text="Đăng xuất" onAction="#logout" styleClass="logout-button" maxWidth="Infinity"/>
        </VBox>
    </left>
    <center>
        <VBox spacing="0">
            <!-- Topbar an theo yeu cau bo header cac trang, giu id pageTitle cho logic & test -->
            <Label fx:id="pageTitle" id="pageTitle" visible="false" managed="false"/>
            <ScrollPane id="pageScroll" fitToWidth="true" fitToHeight="true" hbarPolicy="NEVER" VBox.vgrow="ALWAYS" styleClass="page-scroll">
                <VBox spacing="14" styleClass="page-content" fillWidth="true">
                    <Label fx:id="notice" id="workspaceNotice" styleClass="notice" wrapText="true" maxWidth="Infinity" visible="false" managed="false"/>
                    <StackPane fx:id="content" id="workspaceContent" VBox.vgrow="ALWAYS"/>
                </VBox>
            </ScrollPane>
        </VBox>
    </center>
</BorderPane>
