<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<BorderPane xmlns:fx="http://javafx.com/fxml/1" fx:controller="quiz.client.ui.WorkspaceController" styleClass="workspace">
    <left>
        <VBox prefWidth="236" minWidth="216" maxWidth="236" spacing="24" styleClass="sidebar">
            <Label text="Q / ONLINE QUIZ" styleClass="brand"/>
            <Label fx:id="roleLabel" id="roleLabel" styleClass="role-badge"/>
            <Label text="KHÔNG GIAN LÀM VIỆC" styleClass="eyebrow-light"/>
            <VBox fx:id="adminNavigation" spacing="8" visible="false" managed="false">
                <Button fx:id="adminAccounts" text="Quản lí tài khoản" onAction="#accounts" styleClass="sidebar-navigation-button" maxWidth="Infinity"/>
                <Button fx:id="adminClasses" text="Quản lí lớp học" onAction="#classes" styleClass="sidebar-navigation-button" maxWidth="Infinity"/>
            </VBox>
            <VBox fx:id="teacherNavigation" spacing="8" visible="false" managed="false">
                <Button fx:id="teacherDashboard" text="Không gian giảng dạy" onAction="#teacherDashboard" styleClass="sidebar-navigation-button" maxWidth="Infinity"/>
                <Button fx:id="teacherQuestions" text="Ngân hàng câu hỏi" onAction="#teacherQuestions" styleClass="sidebar-navigation-button" maxWidth="Infinity"/>
            </VBox>
            <Region VBox.vgrow="ALWAYS"/>
            <Separator/>
            <VBox spacing="6">
                <Label fx:id="fullName" id="sessionFullName" styleClass="user-name" wrapText="true"/>
                <Label fx:id="username" id="sessionUsername" styleClass="sidebar-muted" wrapText="true"/>
            </VBox>
            <Button id="logoutButton" text="Đăng xuất" onAction="#logout" styleClass="logout-button" maxWidth="Infinity"/>
        </VBox>
    </left>
    <center>
        <VBox spacing="0">
            <HBox alignment="CENTER_LEFT" spacing="16" styleClass="topbar">
                <Label fx:id="pageTitle" id="pageTitle" styleClass="topbar-title"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label text="Trung tâm đào tạo" styleClass="muted"/>
            </HBox>
            <ScrollPane id="pageScroll" fitToWidth="true" fitToHeight="true" hbarPolicy="NEVER" VBox.vgrow="ALWAYS" styleClass="page-scroll">
                <VBox spacing="18" styleClass="page-content" fillWidth="true">
                    <Label fx:id="notice" id="workspaceNotice" styleClass="notice" wrapText="true" maxWidth="Infinity" visible="false" managed="false"/>
                    <StackPane fx:id="content" id="workspaceContent" VBox.vgrow="ALWAYS"/>
                </VBox>
            </ScrollPane>
        </VBox>
    </center>
</BorderPane>
